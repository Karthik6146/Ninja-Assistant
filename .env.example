NINJA_DATA=./data
# Semicolon-separated folders. Empty disables local-path imports.
NINJA_ROOTS=
# Blank creates a random token in data/access-token.
NINJA_TOKEN=
# Add http://127.0.0.1:5173 only while running the Vite dev server.
NINJA_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
CLOUD_ENABLED=false
CLOUD_URL=
CLOUD_MODEL=
CLOUD_API_KEY=

# Optional existing standalone caption tool (loopback UI only).
CAPTION_TOOL_URL=
CAPTION_TOOL_PATH=

# Optional preinstalled multilingual faster-whisper model directory. Blank reuses cached tiny.
JARVIS_VOICE_MODEL=
